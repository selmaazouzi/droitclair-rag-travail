# Copy to .env and fill in the secrets. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5433/chatbot

# --- Légifrance API (PISTE, OAuth client credentials of your PISTE application) ---
# Production by default. Sandbox (test data, differs from production):
#   LEGIFRANCE_API_URL=https://sandbox-api.piste.gouv.fr/dila/legifrance/lf-engine-app
#   LEGIFRANCE_OAUTH_URL=https://sandbox-oauth.piste.gouv.fr
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=

# --- Ingestion ---
# Raw snapshots written by `python -m ingestion.cli fetch`
DATA_DIR=data
# Split chunks above this many tokens; empty = one article per chunk
CHUNK_MAX_TOKENS=

# --- LLM (LLM_PROVIDER: mistral | ollama) ---
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest
LLM_REWRITE_MODEL=mistral-small-latest
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Retrieval models ---
EMBEDDING_MODEL=BAAI/bge-m3
# empty = auto-detect (Apple GPU "mps", "cuda" or "cpu")
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Retrieval parameters ---
RETRIEVAL_TOP_K_LEXICAL=30
RETRIEVAL_TOP_K_DENSE=30
RRF_K=60
RERANK_TOP_N=6

# --- Pipeline switches (comparative evaluations) ---
ENABLE_LEXICAL=true
ENABLE_RERANK=true
ENABLE_QUERY_REWRITE=true

# --- Prompts ---
PROMPT_SYSTEM_VERSION=system_v1

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Abuse protection ---
RATE_LIMIT_PER_MINUTE=20

# --- Tests only: database used by the integration tests (it is wiped) ---
# TEST_DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5433/chatbot_test
