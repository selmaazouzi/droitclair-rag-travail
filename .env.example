# Copy to .env and fill in the secrets. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5433/chatbot

# --- LLM (LLM_PROVIDER: mistral | ollama) ---
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest
LLM_REWRITE_MODEL=mistral-small-latest
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Retrieval models ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Retrieval parameters ---
RETRIEVAL_TOP_K_LEXICAL=30
RETRIEVAL_TOP_K_DENSE=30
RRF_K=60
RERANK_TOP_N=6

# --- Pipeline switches (comparative evaluations) ---
ENABLE_LEXICAL=true
ENABLE_RERANK=true
ENABLE_QUERY_REWRITE=true

# --- Prompts ---
PROMPT_SYSTEM_VERSION=system_v1

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Abuse protection ---
RATE_LIMIT_PER_MINUTE=20

# --- Tests only: database used by the integration tests (it is wiped) ---
# TEST_DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5433/chatbot_test
